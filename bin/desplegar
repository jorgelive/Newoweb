#!/usr/bin/env bash
#
# Despliegue en producción, con el candado de despliegue tomado.
#
#   ssh openperu /var/www/openperu.pe/bin/desplegar
#
# Orden: pull SIN hooks → autoload si se movieron clases → el hook a mano (para los workers,
# limpia la caché, migra, los arranca y construye el front que haya cambiado). El hook se lanza
# aquí y no desde git porque git ignora su código de salida: un `cache:clear` fallido daba el
# despliegue por bueno. Así cualquier fallo sale con código ≠ 0.
#
# ⚠️ EL CANDADO. Las tareas de cron (tools/cron/www-data.crontab) pasan por `tools/cron/con-candado`,
# que toma var/deploy.lock compartido; aquí se toma en exclusiva. El despliegue espera a que
# terminen las que están en marcha, y las que arrancan mientras tanto esperan a que acabe. Antes
# se esquivaba esperando al minuto 1 de cada cinco, y no bastaba (03/10/2026). Ver CLAUDE.md.
#
# ⚠️ No borres var/deploy.lock con algo corriendo: quien lo tenga abierto se queda con el inodo
# viejo, y el despliegue y el cron dejarían de excluirse hasta que todos lo reabran.

set -euo pipefail
cd "$(dirname "$0")/.."

CANDADO="$PWD/var/deploy.lock"
if [ ! -e "$CANDADO" ]; then
    touch "$CANDADO"
    chmod 666 "$CANDADO"   # lo abren ubuntu (este script) y www-data (el cron)
fi

# El cuerpo va entero en el `bash -c`: lo que está a partir del pull ya es del commit nuevo.
# `-o`: los hijos (composer, vite, sudo) no heredan el candado; si uno se quedara vivo, el cron se
# saltaría todas sus vueltas mientras viviera.
set +e
/usr/bin/flock -x -o -w 600 -E 75 "$CANDADO" bash -euo pipefail -c '
    ANTES=$(git rev-parse HEAD)
    git -c core.hooksPath=/dev/null pull --ff-only

    if [ "$(git rev-parse HEAD)" = "$ANTES" ]; then
        echo "[desplegar] Nada nuevo que desplegar."
        exit 0
    fi

    # Clases borradas o renombradas en src/: el classmap optimizado seguiría apuntando a los
    # archivos viejos (el include fallido del 19/08/2026). Antes del hook, que es quien arranca
    # los workers. Con `$(…)` y no `| grep -q`: con pipefail, el SIGPIPE de git al cortar grep
    # hacía falso el `if` justo en los refactors grandes.
    if [ -n "$(git diff --name-only --diff-filter=DR "$ANTES" HEAD -- src)" ]; then
        echo "[desplegar] Clases movidas o borradas: regenerando el autoload"
        composer dump-autoload --no-dev --optimize --quiet
    fi

    DESPLEGAR_DESDE="$ANTES" ./tools/git-hooks/post-merge

    git log --oneline -1
'
CODIGO=$?
if [ "$CODIGO" -eq 75 ]; then
    echo "[desplegar] ⚠️ No se tomó el candado en 600 s: alguna tarea de cron sigue corriendo. No se ha desplegado nada." >&2
elif [ "$CODIGO" -ne 0 ]; then
    echo "[desplegar] ⚠️ El despliegue FALLÓ (código $CODIGO). Revisa la salida de arriba." >&2
fi
exit "$CODIGO"
