###> Vite ###
# Un SW por app: comparten docroot, así que el nombre genérico hacía que el
# último build pisara al otro (ver docs/PwaNotificaciones.md).
/public/util-service-worker.js
/public/pax-service-worker.js
# Obsoleto: nombre genérico anterior. Se mantiene ignorado para que los
# artefactos que queden en checkouts viejos no entren al repo.
/public/service-worker.js
/public/manifest.webmanifest
/public/workbox-*.js
# Los generan los `npm run build` de cada app (manifestFilename en su
# vite.config.ts) y los copian a public/: son artefactos, no fuente.
/public/pax-manifest.webmanifest
/public/util-manifest.webmanifest
/public/app_pax/
/pax/.env.development
/pax/.env.production
/pax/certs/
/dominio/node_modules/
/pax/node_modules/

/public/app_util/
/util/.env.development
/util/.env.production
/util/certs/
/util/node_modules/

