{
  "name": "util-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "gen:api": "php ../bin/console cache:pool:clear --all --quiet && php ../bin/console api:openapi:export -o .openapi.json && openapi-typescript .openapi.json -o src/types/api.d.ts && rm .openapi.json",
    "build": "vite build && node scripts/pwa-postbuild.mjs",
    "verify:deploy": "node scripts/pwa-verify-deploy.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/resource": "^6.1.21",
    "@fullcalendar/resource-timeline": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@vuepic/vue-datepicker": "^14.0.0",
    "axios": "^1.7.9",
    "imask": "^7.6.1",
    "libphonenumber-js": "^1.13.10",
    "pinia": "^3.0.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.2.0",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.4"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
